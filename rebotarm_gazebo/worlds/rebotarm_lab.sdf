<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rebotarm_lab">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.52 0.55 0.60 1</ambient>
      <background>0.42 0.56 0.70 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.45 0.2 -0.87</direction>
    </light>
    <light name="workcell_light" type="point">
      <pose>2.8 0 2.8 0 0 0</pose><cast_shadows>false</cast_shadows>
      <diffuse>0.72 0.78 0.88 1</diffuse><specular>0.12 0.12 0.12 1</specular>
      <attenuation><range>8</range><constant>0.6</constant><linear>0.04</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="storage_light" type="point">
      <pose>-2.8 1.7 2.6 0 0 0</pose><cast_shadows>false</cast_shadows>
      <diffuse>0.70 0.76 0.84 1</diffuse><specular>0.10 0.10 0.10 1</specular>
      <attenuation><range>7</range><constant>0.6</constant><linear>0.04</linear><quadratic>0.01</quadratic></attenuation>
    </light>

