{
  "name": "rebotarm-web-mujoco",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser MuJoCo demo for B601-RS with an optional AGV base",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "smoke": "node scripts/smoke-load.mjs",
    "test:variants": "node scripts/test-agv-path-planner.mjs && node scripts/smoke-variants.mjs",
    "test:explode": "node scripts/test-explosion-layout.mjs && node scripts/test-explosion-timeline.mjs"
  },
  "dependencies": {
    "@mujoco/mujoco": "^3.12.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
